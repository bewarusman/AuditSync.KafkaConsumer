# =============================================================================
# AuditSync Oracle Consumer Configuration
# =============================================================================
# Copy this file to .env and update with your actual values

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=oracle.audit.events
KAFKA_GROUP_ID=auditsync-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Kafka SSL/TLS Configuration (optional - for secure connections)
# Uncomment and configure these if connecting to a secure Kafka cluster (e.g., Aiven Cloud)
# KAFKA_SECURITY_PROTOCOL=Ssl
# KAFKA_SSL_CA_LOCATION=certs/ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=certs/service.cert
# KAFKA_SSL_KEY_LOCATION=certs/service.key

# -----------------------------------------------------------------------------
# Oracle Configuration
# -----------------------------------------------------------------------------
ORACLE_HOST=192.168.76.83
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=dbm
ORACLE_USERNAME=aud_admin
ORACLE_PASSWORD=N@d4!El61ON8!v
ORACLE_MIN_POOL_SIZE=1
ORACLE_MAX_POOL_SIZE=10
ORACLE_CONNECTION_TIMEOUT=30

# -----------------------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------------------
PROCESSING_BATCH_SIZE=100
PROCESSING_MAX_RETRY_COUNT=3
PROCESSING_RETRY_BACKOFF_MS=5000

# -----------------------------------------------------------------------------
# Rules Engine Configuration (NEW)
# -----------------------------------------------------------------------------
# Target name for filtering rules (must match TARGETS.NAME in database)
AUDITSYNC_TARGET_SYSTEM_NAME=DWH

# Rules cache refresh interval (hours)
AUDITSYNC_RULES_CACHE_REFRESH_HOURS=24

# JavaScript execution timeout (seconds)
AUDITSYNC_JAVASCRIPT_TIMEOUT_SECONDS=5

# Enable/disable rules engine (true/false)
# If false, will use legacy extraction rules from target_rules table
AUDITSYNC_ENABLE_RULES_ENGINE=true
